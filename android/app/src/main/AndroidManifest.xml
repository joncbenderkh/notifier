<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Sets snoozed messages' alarms again after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Shows snoozed messages on time, once the user allows it ("Alarms &
         reminders"); without it they may come late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- allowBackup is off: pairing secrets are wrapped by an Android Keystore
         key that never leaves the device, so a restored copy is unreadable. -->
    <application
        android:name=".NotifierApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notifier">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR codes encode notifier://pair?server=...&code=... (pairing) and
                 notifier://join?... (channel invites). Opening one never acts by
                 itself: a pair link pre-fills the form, a join link asks first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="pair"
                    android:scheme="notifier" />
                <data
                    android:host="join"
                    android:scheme="notifier" />
            </intent-filter>
        </activity>

        <!-- Fetch the code scanner module at install time rather than on first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- A tap on a message with a link or sent with receipts, or a link
             button: reports it opened if asked, then opens the link or
             MainActivity. Not exported, so no other app can report. -->
        <activity
            android:name=".push.OpenedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".push.ReplyReceiver"
            android:exported="false" />

        <!-- "Snooze" on a notification: asks when to show it again. -->
        <activity
            android:name=".push.SnoozeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".push.ReminderReceiver"
            android:exported="false" />

        <!-- Exported for the system's boot and update broadcasts only. -->
        <receiver
            android:name=".push.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
