{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // "fcm" delivers through Firebase; "log" only logs (local development).
    "PUSH_TRANSPORT": "fcm"
  },
  // Secrets, set with `npx wrangler secret put <NAME>` (or `.dev.vars` locally):
  //   ADMIN_TOKEN          at least 32 characters
  //   FCM_SERVICE_ACCOUNT  the Firebase service-account JSON, verbatim
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notifier",
      "database_id": "6655fe1d-cd78-4fa1-a0b3-4b17b8cb5863",
      "migrations_dir": "migrations"
    }
  ]
}
