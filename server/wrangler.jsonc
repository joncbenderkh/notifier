{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    // "fcm" delivers through Firebase; "log" only logs (local development).
    "PUSH_TRANSPORT": "fcm"
  },
  // Secrets, set with `npx wrangler secret put <NAME>` (or `.dev.vars` locally):
  //   ADMIN_TOKEN          the operator's token (user management), at least
  //                        32 characters: `openssl rand -hex 32`
  //   FCM_SERVICE_ACCOUNT  the Firebase service-account JSON, verbatim
  // Every minute: alert heartbeats whose check-in is overdue (src/heartbeats.ts).
  "triggers": { "crons": ["* * * * *"] },
  // Per-user cap on POST /v1/notifications. Counted per Cloudflare location,
  // so it is a guard against runaway scripts, not an exact quota.
  "ratelimits": [
    {
      "name": "NOTIFY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // DEVICE_STREAM: one per WebSocket-transport device (src/stream.ts), its
  // socket and queue. REPLY_BOX: one per question (src/replies.ts), its answer.
  // RECEIPT_BOX: one per message sent with receipts (src/receipts.ts).
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_STREAM", "class_name": "DeviceStream" },
      { "name": "REPLY_BOX", "class_name": "ReplyBox" },
      { "name": "RECEIPT_BOX", "class_name": "ReceiptBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceStream"] },
    { "tag": "v2", "new_sqlite_classes": ["ReplyBox"] },
    { "tag": "v3", "new_sqlite_classes": ["ReceiptBox"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notifier",
      "database_id": "6655fe1d-cd78-4fa1-a0b3-4b17b8cb5863",
      "migrations_dir": "migrations"
    }
  ]
}
